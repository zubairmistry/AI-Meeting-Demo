# ==============================================================================
# Django Security & Environment Configuration
# ==============================================================================
SECRET_KEY=replace-with-a-strong-random-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.onrender.com

# ==============================================================================
# Symmetrical Encryption Key (Fernet Base64)
# Generate a new key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ==============================================================================
ENCRYPTION_KEY=replace-with-your-base64-fernet-key=

# ==============================================================================
# Database Configuration (PostgreSQL / MySQL / SQLite Fallback)
# ==============================================================================
# PostgreSQL (Recommended for cloud hosting like Render/Supabase)
# DATABASE_URL=postgres://user:password@hostname:5432/dbname

# MySQL (Optional local/managed MySQL)
# DB_NAME=meeting_db
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# ==============================================================================
# Optional FFmpeg Binary Path (Auto-discovered if on system PATH)
# ==============================================================================
# FFMPEG_PATH=/usr/bin/ffmpeg

# ==============================================================================
# Optional File Upload Limit (in bytes) - Defaults to 52428800 (50 MB)
# For local long-duration video testing (e.g. 2 GB), uncomment and configure:
# MAX_UPLOAD_SIZE=2147483648
# ==============================================================================
# MAX_UPLOAD_SIZE=52428800

